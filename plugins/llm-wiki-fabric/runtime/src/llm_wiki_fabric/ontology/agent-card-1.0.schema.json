{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "card_url": {
      "type": "string",
      "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tags"
        ]
      }
    },
    "knowledge_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
          }
        },
        "required": [
          "id",
          "url"
        ]
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "kind": {
                "const": "clone-and-invoke"
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
              },
              "bundle_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "bundle_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "kind": {
                "const": "mcp"
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
              },
              "transport": {
                "const": "streamable-http"
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "transport"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "kind": {
                "const": "a2a"
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^/?#@]+(/[^?#]*)?$"
              },
              "transport": {
                "type": "string",
                "minLength": 1
              },
              "protocol_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "transport",
              "protocol_version"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "card_url",
    "skills",
    "knowledge_bundles",
    "interfaces"
  ]
}
